# base image with python / imagem base com python
FROM python:3.11-slim

# libgomp is required by lightgbm / libgomp é exigida pelo lightgbm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# install dependencies first to use the build cache / instala as dependências primeiro para aproveitar o cache do build
COPY docker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# app code and the lightgbm model (small, ~1 MB) / código do app e o modelo lightgbm (pequeno, ~1 MB)
COPY app/streamlit_app.py ./streamlit_app.py
COPY models/random_forest.joblib ./models/random_forest.joblib
ENV MODELO_PATH=/app/models/random_forest.joblib

EXPOSE 8501
CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
